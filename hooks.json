{
  "claude-plugin": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|edit_file|replace_file_content|multi_replace_file_content|write_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/antigravity-adapter.sh PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/antigravity-adapter.sh PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/antigravity-adapter.sh SessionStart",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/antigravity-adapter.sh PreInvocation",
        "timeout": 15
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/antigravity-adapter.sh PostInvocation",
        "timeout": 15
      }
    ]
  }
}
